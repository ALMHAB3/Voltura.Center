# Copy to .env.local and fill in. Never commit .env.local.

# Public site address (used for links, sitemap and SEO tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings → API). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix with NEXT_PUBLIC_. Used only by scripts/create-admin.mjs.
SUPABASE_SERVICE_ROLE_KEY=

# Vanex delivery (optional). Leave empty until Vanex gives you an API key.
VANEX_API_URL=
VANEX_API_KEY=
